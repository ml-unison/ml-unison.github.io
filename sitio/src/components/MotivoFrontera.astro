---
// Motivo gráfico del curso: dos clases y una frontera de decisión no lineal
// (mismo algoritmo que presentaciones/components/MotivoFrontera.vue).
interface Props { ancho?: number; alto?: number; n?: number; semilla?: number; clase?: string }
const { ancho: W = 560, alto: H = 520, n = 140, semilla = 7, clase = '' } = Astro.props

function mulberry32(a: number) {
  return () => {
    a |= 0; a = (a + 0x6D2B79F5) | 0
    let t = Math.imul(a ^ (a >>> 15), 1 | a)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
}
const rnd = mulberry32(semilla)
const frontera = (x: number) => H * (0.52 + 0.16 * Math.sin((x / W) * 2 * Math.PI * 0.9 + 0.6) + 0.05 * Math.sin((x / W) * 9))
const puntos = Array.from({ length: n }, () => {
  const x = rnd() * W, y = rnd() * H
  const c = (y - frontera(x) + (rnd() - 0.5) * 70) > 0
  return { x: x.toFixed(1), y: y.toFixed(1), c, r: (4 + rnd() * 3.5).toFixed(1), o: (0.55 + rnd() * 0.45).toFixed(2) }
})
const curva = Array.from({ length: 121 }, (_, i) => {
  const x = (i / 120) * W
  return `${i ? 'L' : 'M'}${x.toFixed(1)},${frontera(x).toFixed(1)}`
}).join('')
---
<svg class={clase} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <path d={`${curva}L${W},${H}L0,${H}Z`} fill="#24398A" opacity="0.55" />
  <path d={curva} fill="none" stroke="#E1B73D" stroke-width="2.5" stroke-dasharray="10 8" />
  {puntos.map(p => p.c
    ? <circle cx={p.x} cy={p.y} r={p.r} fill="#E1B73D" opacity={p.o} />
    : <circle cx={p.x} cy={p.y} r={p.r} fill="none" stroke="#8DA3C9" stroke-width="2.2" opacity={p.o} />)}
</svg>
