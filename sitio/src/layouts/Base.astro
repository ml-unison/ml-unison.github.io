---
import '../estilos/global.css'
import Icono from '../components/Icono.astro'
import { curso } from '../datos/curso'
import { url } from '../lib/rutas'

interface Props { titulo?: string; descripcion?: string; seccion?: string }
const { titulo, descripcion = `${curso.nombre}: curso de aprendizaje automático de la ${curso.programa}, ${curso.universidad}.`, seccion = '' } = Astro.props
const tituloPagina = titulo ? `${titulo} · ${curso.nombre}` : `${curso.nombre} · ${curso.universidad}`
const vistaPrevia = import.meta.env.BASE_URL.includes('preview')

const menu = [
  { texto: 'Unidades', href: '#unidades', id: 'unidades' },
  { texto: 'Proyecto', href: 'proyecto/', id: 'proyecto' },
  { texto: 'Evaluación', href: 'evaluacion/', id: 'evaluacion' },
  { texto: 'Recursos', href: 'recursos/', id: 'recursos' },
]
const enlace = (h: string) => h.startsWith('#') ? url('') + h : url(h)
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{tituloPagina}</title>
  <meta name="description" content={descripcion}>
  <link rel="icon" type="image/png" href={url('marca/favicon.png')}>
  <meta name="theme-color" content="#20305A">
</head>
<body>
  {vistaPrevia && <div class="vista-previa">Vista previa del rediseño · no es el sitio oficial del curso</div>}
  <header class="encabezado">
    <div class="contenedor encabezado__fila">
      <a class="marca" href={url('')}>
        <img src={url('marca/letragrama-unison.png')} alt="Universidad de Sonora" width="112" height="36">
        <span class="marca__curso">Reconocimiento<br>de Patrones</span>
      </a>
      <div class="navegacion" data-nav>
        <button type="button" class="navegacion__boton" aria-label="Menú" aria-expanded="false" aria-controls="menu"><Icono nombre="menu" /></button>
        <nav id="menu">
          {menu.map(m => <a href={enlace(m.href)} class={seccion === m.id ? 'activo' : ''}>{m.texto}</a>)}
        </nav>
      </div>
    </div>
  </header>

  <main><slot /></main>

  <footer class="pie">
    <div class="contenedor pie__fila">
      <div class="pie__marca">
        <img src={url("marca/buho-blanco.png")} alt="" width="70" height="57">
        <div>
          <strong>{curso.universidad}</strong><br>
          {curso.departamento}<br>
          {curso.programa}
        </div>
      </div>
      <div class="pie__texto">
        <p>Material del curso {curso.nombre}, {curso.profesor}. El contenido se publica bajo licencia <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.es">CC BY-SA 4.0</a> y el código bajo licencia MIT.</p>
        <p><a href={`https://github.com/${curso.repo}`}>Repositorio en GitHub</a> · <a href={`mailto:${curso.correo}`}>{curso.correo}</a></p>
      </div>
    </div>
  </footer>
  <script>
    const nav = document.querySelector('[data-nav]')!
    const boton = nav.querySelector('button')!
    boton.addEventListener('click', () => {
      const abierto = nav.classList.toggle('abierto')
      boton.setAttribute('aria-expanded', String(abierto))
    })
    nav.querySelectorAll('a').forEach(a => a.addEventListener('click', () => nav.classList.remove('abierto')))
  </script>
</body>
</html>

<style>
  .vista-previa { background: var(--dorado); color: var(--marino); font: 600 0.8rem/1 var(--f-titulo); text-align: center; padding: 8px 16px; letter-spacing: .02em; }

  .encabezado { background: #fff; border-bottom: 1px solid var(--linea); position: sticky; top: 0; z-index: 10; }
  .encabezado__fila { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .marca { display: flex; align-items: center; gap: 16px; text-decoration: none; }
  .marca img { height: 34px; width: auto; }
  .marca__curso { font: 650 0.86rem/1.15 var(--f-titulo); color: var(--marino); border-left: 1px solid var(--linea); padding-left: 16px; letter-spacing: -0.005em; }

  .navegacion__boton { display: none; }
  .navegacion nav { display: flex; gap: 4px; }
  .navegacion nav a {
    font: 550 0.9rem/1 var(--f-titulo);
    color: var(--tinta);
    text-decoration: none;
    padding: 10px 14px;
    border-radius: 8px;
  }
  .navegacion nav a:hover { background: var(--fondo-alt); }
  .navegacion nav a.activo { color: var(--azul); box-shadow: inset 0 -3px 0 var(--dorado); border-radius: 0; }

  @media (max-width: 820px) {
    .navegacion { position: relative; }
    .navegacion__boton { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 8px; cursor: pointer; color: var(--marino); background: none; border: 0; }
    .navegacion__boton svg { width: 24px; height: 24px; }
    .navegacion nav { display: none; }
    .navegacion.abierto nav {
      display: flex; flex-direction: column; position: absolute; right: 0; top: 52px; min-width: 220px;
      background: #fff; border: 1px solid var(--linea); border-radius: var(--radio); padding: 8px; box-shadow: 0 12px 32px rgba(26,33,51,.12);
    }
    .navegacion nav a.activo { box-shadow: inset 3px 0 0 var(--dorado); }
  }

  .pie { background: var(--marino-prof); color: var(--azul-tenue); margin-top: 96px; padding: 48px 0; font-size: 0.9rem; }
  .pie__fila { display: grid; grid-template-columns: auto 1fr; gap: 56px; align-items: start; }
  .pie__marca { display: flex; gap: 16px; align-items: center; line-height: 1.45; }
  .pie__marca strong { color: #fff; font-family: var(--f-titulo); font-weight: 600; }
  .pie__marca img { height: 52px; width: auto; opacity: .9; }
  .pie__texto { max-width: 560px; justify-self: end; }
  .pie__texto p { margin: 0 0 .6em; }
  .pie a { color: #fff; }
  @media (max-width: 760px) { .pie__fila { grid-template-columns: 1fr; gap: 28px; } .pie__texto { justify-self: start; } }
</style>
